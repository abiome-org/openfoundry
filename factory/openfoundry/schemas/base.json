{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.openfoundry.dev/v1alpha1/base.json","$defs":{"metadata":{"type":"object","required":["name"],"properties":{"name":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9.-]{0,61}[a-z0-9])?$"},"namespace":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9./-]{0,126}[a-z0-9])?$"},"uid":{"type":"string","format":"uuid"},"revision":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"createdAt":{"type":"string","format":"date-time","pattern":"(?:Z|[+-][0-9]{2}:[0-9]{2})$"},"createdBy":{"type":"string","minLength":1}},"additionalProperties":false},"extension":{"type":"object","additionalProperties":true}}}
