{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openfoundry-kind": "ModelPackage",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "openfoundry.dev/v1alpha1"
    },
    "kind": {
      "const": "ModelPackage"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "required": [
        "signatures",
        "adapters",
        "compatibilityVectors"
      ],
      "properties": {
        "signatures": {
          "type": "object",
          "required": [
            "input",
            "output",
            "state"
          ],
          "properties": {
            "input": {
              "type": "object"
            },
            "output": {
              "type": "object"
            },
            "state": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "adapters": {
          "type": "object",
          "required": [
            "trainingReference",
            "inferenceReference"
          ],
          "properties": {
            "trainingReference": {
              "type": "object",
              "required": [
                "stage",
                "operation",
                "config"
              ],
              "properties": {
                "stage": {
                  "type": "string",
                  "minLength": 1
                },
                "operation": {
                  "enum": [
                    "validate",
                    "prepare",
                    "run",
                    "quiesce",
                    "checkpoint",
                    "restore",
                    "stop"
                  ]
                },
                "config": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            },
            "inferenceReference": {
              "type": "object",
              "required": [
                "module",
                "operation",
                "stateOutput",
                "config"
              ],
              "properties": {
                "module": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "operation": {
                  "enum": [
                    "validate",
                    "prepare",
                    "run",
                    "quiesce",
                    "checkpoint",
                    "restore",
                    "stop"
                  ]
                },
                "stateOutput": {
                  "type": "string",
                  "minLength": 1
                },
                "config": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "compatibilityVectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "method",
              "inputs",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "enum": [
                  "predict",
                  "generate",
                  "embed",
                  "score",
                  "custom"
                ]
              },
              "inputs": {
                "type": "object"
              },
              "expected": {
                "type": "object"
              },
              "tolerances": {
                "type": "object"
              },
              "seed": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "extensions": {
          "$ref": "#/$defs/extension"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
