{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openfoundry-kind": "DeploymentSpec",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "openfoundry.dev/v1alpha1"
    },
    "kind": {
      "const": "DeploymentSpec"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "required": [
        "releaseRef"
      ],
      "properties": {
        "releaseRef": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "$ref": "#/$defs/extension"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
