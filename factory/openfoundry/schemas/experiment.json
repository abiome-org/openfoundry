{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openfoundry-kind": "Experiment",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "openfoundry.dev/v1alpha1"},
    "kind": {"const": "Experiment"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["baselineRef", "candidateRef", "evaluationRefs", "metric", "direction", "decision"],
      "properties": {
        "baselineRef": {"type": "string"},
        "candidateRef": {"type": "string"},
        "evaluationRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "metric": {"type": "string"},
        "direction": {"enum": ["maximize", "minimize"]},
        "decision": {"enum": ["candidate", "baseline", "tie"]},
        "delta": {"type": "number"},
        "extensions": {"$ref": "#/$defs/extension"}
      },
      "additionalProperties": false
    },
    "status": {"type": "object"}
  },
  "additionalProperties": false
}
