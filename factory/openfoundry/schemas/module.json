{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openfoundry-kind": "Module",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "openfoundry.dev/v1alpha1"
    },
    "kind": {
      "const": "Module"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "required": [
        "entryPoint",
        "environment"
      ],
      "properties": {
        "entryPoint": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "codeRoot": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            }
          },
          "additionalProperties": false
        },
        "contracts": {
          "type": "object",
          "properties": {
            "input": {
              "type": "object"
            },
            "output": {
              "type": "object"
            },
            "config": {
              "type": "object"
            },
            "state": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "required": [
            "dependencyLock",
            "dependencyDigest"
          ],
          "properties": {
            "dependencyLock": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "dependencyDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "checkpoint": {
          "type": "boolean"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "request",
              "result"
            ],
            "properties": {
              "request": {
                "type": "object"
              },
              "result": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "extensions": {
          "$ref": "#/$defs/extension"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
